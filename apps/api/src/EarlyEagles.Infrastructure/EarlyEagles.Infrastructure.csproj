<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EarlyEagles.Application\EarlyEagles.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 (LTS, per ADR-0006) + the Npgsql provider. The provider pins
         EF Core to [10.0.4, 11.0.0); 10.0.11 is the latest compatible patch. -->
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <!-- Pin Relational to match: the Npgsql 10.0.3 provider references 10.0.4,
         which otherwise wins assembly resolution and trips MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Entra token auth to Azure Postgres (P0-062.2.1): DefaultAzureCredential
         resolves to the Container App's managed identity in Azure. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Outbox publisher to the domain-events topic (P0-050.2.2). -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <!-- BackgroundService + AddHostedService for the outbox drain (P0-050.1),
         and options binding/validation for its configuration section. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <!-- Typed HttpClient for the Resend email sender (P0-053.1). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <!-- IHealthCheck for the database readiness check (P0-026.2). The API
         registers it; the full HealthChecks package comes with ASP.NET Core. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
