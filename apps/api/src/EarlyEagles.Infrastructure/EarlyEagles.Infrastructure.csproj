<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EarlyEagles.Application\EarlyEagles.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 (LTS, per ADR-0006) + the Npgsql provider. The provider pins
         EF Core to [10.0.4, 11.0.0); 10.0.11 is the latest compatible patch. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Pin Relational to match: the Npgsql 10.0.3 provider references 10.0.4,
         which otherwise wins assembly resolution and trips MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- BackgroundService + AddHostedService for the outbox drain (P0-050.1),
         and options binding/validation for its configuration section. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
