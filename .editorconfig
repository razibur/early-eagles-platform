root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# C# / .NET
[*.{cs,csx,vb,vbx}]
indent_size = 4

[*.{csproj,vbproj,fsproj,proj,props,targets,sln}]
indent_size = 2

# Web / TypeScript
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}]
indent_size = 2

[*.{html,css,scss,sass,less}]
indent_size = 2

# Config / data
[*.{yml,yaml,toml}]
indent_size = 2

# Bicep
[*.{bicep,bicepparam}]
indent_size = 2

# Markdown — preserve trailing whitespace (line breaks)
[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

# Makefile requires tabs
[Makefile]
indent_style = tab
