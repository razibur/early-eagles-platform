# Local dev stack (docker-compose.yml). Copy to .env, which is git-ignored.
# Plain `docker compose up` (Postgres) needs nothing here; the emulator
# settings below are only for `docker compose --profile bus up`.

# Host port for the Postgres container (default 55432, clear of a native 5432).
# POSTGRES_PORT=55432

# Y = you accept the licence terms of the Service Bus emulator
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# and SQL Server for Linux
#   https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA=N

# SA password for the emulator's SQL Server container. Local only; must meet
# SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=
